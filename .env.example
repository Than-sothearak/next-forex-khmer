# Public page stays in demo mode until a data provider and license are configured.
ECONOMIC_CALENDAR_PROVIDER=demo
MONGODB_URI=
TRADING_ECONOMICS_API_KEY=
CALENDAR_REDISTRIBUTION_LICENSE_CONFIRMED=false

# Apify economic calendar adapter. Enable only when your agreement permits reuse.
APIFY_API_TOKEN=
APIFY_CALENDAR_SOURCE=forexfactory
APIFY_FOREXFACTORY_PERMISSION_CONFIRMED=false
APIFY_FXSTREET_PERMISSION_CONFIRMED=false
CALENDAR_SYNC_INTERVAL_MINUTES=60
CALENDAR_SYNC_SECRET=

# OpenAI runs server-side for calendar/news Khmer translations and news insights.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required to publish news. Never expose this in a NEXT_PUBLIC_ variable.
ADMIN_API_KEY=

# Use the Xtracto Forex Factory calendar actor.
MONGODB_URI=

# Apify economic calendar adapter. Enable only when your agreement permits reuse.
APIFY_CALENDAR_SOURCE=xtracto/forexfactory-calendar
APIFY_API_TOKEN=
# Xtracto Forex Factory actor; change only after confirming permission for your use.
CALENDAR_SYNC_INTERVAL_MINUTES=60
CALENDAR_SYNC_SECRET=
# Automatic polling for a continuously running Node server (npm run dev/start).
# Serverless deployments need an external scheduler instead.
CALENDAR_AUTO_SYNC=false
# OpenAI runs server-side for calendar/news Khmer translations and news insights.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required to publish news. Never expose this in a NEXT_PUBLIC_ variable.
ADMIN_API_KEY=
